# SConstruct
import os
import sys

env = SConscript("godot-cpp/SConstruct")

if env["platform"] == "windows":
    # Flag per il compilatore MSVC (cl.exe)
    # /std:c++17 -> Abilita lo standard C++17.
    # /EHsc       -> Abilita le eccezioni C++ (equivalente a -fexceptions).
    # NON aggiungere /MD o /MT perché godot-cpp lo gestisce già
    env.Append(CXXFLAGS=['/std:c++17', '/EHsc'])
    
    # Definizioni necessarie per esportare simboli da DLL
    env.Append(CPPDEFINES=['_WINDOWS', 'TYPELIB_IS_MODULE', 'GDEXTENSION_EXPORT'])
    
    # Assicurati che i simboli siano esportati correttamente
    env.Append(LINKFLAGS=['/EXPORT:godot_redis_library_init'])
else:
    # Flag per compilatori GCC/Clang (Linux, macOS, etc.)
    # Abilita C++17, richiesto da redis-plus-plus
    env.Append(CXXFLAGS=['-std=c++17', '-fPIC', '-fexceptions'])

# Ottieni la piattaforma target. Default a 'linux'
platform = ARGUMENTS.get("platform", "linux")
env.Append(CPPDEFINES=[
    f"ON_{platform.upper()}"
])

if env["platform"] == "windows":
    # VCPKG_ROOT è una variabile d'ambiente che punta alla tua installazione di vcpkg
    vcpkg_root = os.environ.get("VCPKG_ROOT")
    if vcpkg_root:
        vcpkg_installed_dir = os.path.join(vcpkg_root, "installed", "x64-windows")
        
        # Aggiungi i percorsi degli header
        env.Append(CPPPATH=[
            os.path.join(vcpkg_installed_dir, "include")
        ])
        
        # Aggiungi i percorsi delle librerie (.lib)
        env.Append(LIBPATH=[
            os.path.join(vcpkg_installed_dir, "lib")
        ])

        # --- LIBRERIE PER WINDOWS ---
        # I nomi delle librerie OpenSSL generate da vcpkg potrebbero essere libssl e libcrypto.
        # È buona pratica aggiungerli esplicitamente.
        # Inoltre, aggiungiamo le librerie di sistema necessarie.
        libs_windows = ['hiredis', 'uv', 'libssl', 'libcrypto', 'ws2_32', 'iphlpapi', 'crypt32', 'user32']
        
        # Aggiunge il suffisso 'd' alle librerie se la build è di tipo debug
        suffix = 'd' if ARGUMENTS.get('target') == 'debug' else ''
        env.Append(LIBS=[lib + suffix for lib in libs_windows])
        
        # --- COPIA AUTOMATICA DELLE DLL ---
        # Aggiungiamo un'azione post-compilazione per copiare le DLL necessarie.
        def copy_vcpkg_dlls(target, source, env):
            vcpkg_bin_dir = os.path.join(vcpkg_installed_dir, "bin")
            addon_bin_dir = os.path.join(str(env.Dir('.')), 'bin')
            
            # Elenco delle DLL da copiare
            suffix = 'd' if ARGUMENTS.get('target') == 'debug' else ''
            required_dlls = [f'hiredis{suffix}.dll', f'libuv{suffix}.dll']
            
            # Per OpenSSL, i nomi possono variare, quindi usiamo un glob
            import glob
            # Nota: le DLL di OpenSSL non hanno il suffisso 'd'
            required_dlls.extend([os.path.basename(f) for f in glob.glob(os.path.join(vcpkg_bin_dir, 'libcrypto-*.dll'))])
            required_dlls.extend([os.path.basename(f) for f in glob.glob(os.path.join(vcpkg_bin_dir, 'libssl-*.dll'))])

            for dll in required_dlls:
                env.Install(addon_bin_dir, os.path.join(vcpkg_bin_dir, dll))

    else:
        print("WARNING: VCPKG_ROOT environment variable not set. Windows build may fail.")
else:
    env.Append(LIBS=['hiredis', 'ssl', 'crypto', 'uv'])

env.Append(CPPPATH=[
    'thirdparty/redis-plus-plus/src'
])

# Elenca i nostri file sorgente C++ (.cpp)
sources = Glob('src/*.cpp')

# Aggiungi solo i file sorgente essenziali di redis-plus-plus
# Evita i file async che richiedono dipendenze aggiuntive
redis_plusplus_base = 'thirdparty/redis-plus-plus/src/sw/redis++'
redis_plusplus_sources = [
    os.path.join(redis_plusplus_base, 'command.cpp'),
    os.path.join(redis_plusplus_base, 'command_options.cpp'),
    os.path.join(redis_plusplus_base, 'connection.cpp'),
    os.path.join(redis_plusplus_base, 'connection_pool.cpp'),
    os.path.join(redis_plusplus_base, 'crc16.cpp'),
    os.path.join(redis_plusplus_base, 'errors.cpp'),
    os.path.join(redis_plusplus_base, 'pipeline.cpp'),
    os.path.join(redis_plusplus_base, 'redis.cpp'),
    os.path.join(redis_plusplus_base, 'redis_cluster.cpp'),
    os.path.join(redis_plusplus_base, 'redis_uri.cpp'),
    os.path.join(redis_plusplus_base, 'reply.cpp'),
    os.path.join(redis_plusplus_base, 'sentinel.cpp'),
    os.path.join(redis_plusplus_base, 'shards.cpp'),
    os.path.join(redis_plusplus_base, 'shards_pool.cpp'),
    os.path.join(redis_plusplus_base, 'subscriber.cpp'),
    os.path.join(redis_plusplus_base, 'transaction.cpp'),
]
sources.extend(redis_plusplus_sources)

# Specifica dove mettere la libreria compilata e come chiamarla
# La cartella 'bin' verrà creata automaticamente
library_path = 'bin/libGodotRedis'

# Comando per compilare la libreria condivisa (.so su Linux)
library = env.SharedLibrary(
    target=library_path,
    source=sources
)

# Imposta la libreria come target di default
Default(library)

