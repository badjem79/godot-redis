; godot_redis_cpp.gdextension
[configuration]

entry_symbol = "godot_redis_library_init"
compatibility_minimum = "4.5.1"

[libraries]

linux.x86_64 = "res://addons/godot_redis_cpp/bin/libGodotRedis.so"
windows.x86_64 = "res://addons/godot_redis_cpp/bin/libGodotRedis.dll"
# macos.x86_64 = "res://addons/godot_redis_cpp/bin/libGodotRedis.dylib"
# macos.arm64 = "res://addons/godot_redis_cpp/bin/libGodotRedis.dylib"
